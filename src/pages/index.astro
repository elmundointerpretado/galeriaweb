---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Galería de Fotos</title>
  </head>
  <body>
<header>
  <h1>Galería de Fotos</h1>
  <nav>
    <a href="/fotografos">Fotógrafos</a>
    <a href="/historia">Historia</a>
  </nav>
</header>

    <main>
      <div class="gallery" id="gallery">
        {galleryImages.map((img) => (
          <img src={img.src} alt={img.alt} data-photo={JSON.stringify(img)} />
        ))}
      </div>
    </main>

    <div id="myModal" class="modal" aria-hidden="true">
      <span class="close" aria-label="Cerrar">&times;</span>
      <img class="modal-content" id="modalImg" alt="" />
      <div class="modal-caption" id="caption"></div>
    </div>

    <script>
      type Photo = {
        src: string;
        alt: string;
        photographer: string;
        year: number;
      };

      const modalElement = document.getElementById('myModal');
      const modalImgElement = document.getElementById('modalImg');
      const captionElement = document.getElementById('caption');
      const closeButtonElement = document.querySelector('.close');
      const galleryElement = document.getElementById('gallery');

      if (!modalElement || !modalImgElement || !captionElement || !galleryElement || !closeButtonElement) {
        throw new Error('Faltan elementos del DOM para la galería y el modal.');
      }

      const modal = modalElement as HTMLDivElement;
      const modalImg = modalImgElement as HTMLImageElement;
      const caption = captionElement as HTMLDivElement;
      const closeButton = closeButtonElement as HTMLSpanElement;
      const gallery = galleryElement as HTMLDivElement;

      function openModal(img: Photo): void {
        modal.style.display = 'block';
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        caption.innerHTML = `${img.alt} – Fotógrafo: ${img.photographer}, Año: ${img.year}`;
      }

      const photoItems = Array.from(gallery.querySelectorAll('img')) as HTMLImageElement[];

      photoItems.forEach((img: HTMLImageElement) => {
        img.addEventListener('click', () => {
          const rawPhoto = img.getAttribute('data-photo');
          if (!rawPhoto) return;

          const photo = JSON.parse(rawPhoto) as Partial<Photo>;
          if (photo.src && photo.alt && photo.photographer && typeof photo.year === 'number') {
            openModal({
              src: photo.src,
              alt: photo.alt,
              photographer: photo.photographer,
              year: photo.year,
            });
          }
        });
      });

      closeButton.addEventListener('click', () => {
        modal.style.display = 'none';
      });

      window.addEventListener('click', (event: MouseEvent) => {
        if (event.target === modal) {
          modal.style.display = 'none';
        }
      });
    </script>
  </body>
</html>
